{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft role contract v0.1",
  "description": "Shape-only pilot, not an adopted universal ontology or implementation registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "status", "purpose", "responsibilities", "exclusions", "inputs", "outputs", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "pattern": "^role\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "label": {"type": "string", "minLength": 1},
    "status": {"const": "draft"},
    "purpose": {"type": "string", "minLength": 1},
    "responsibilities": {"$ref": "#/$defs/nonemptyStrings"},
    "exclusions": {"$ref": "#/$defs/nonemptyStrings"},
    "inputs": {"$ref": "#/$defs/nonemptyStrings"},
    "outputs": {"$ref": "#/$defs/nonemptyStrings"},
    "acceptance_criteria": {"$ref": "#/$defs/nonemptyStrings"}
  },
  "$defs": {"nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
